# AI Content Generation (required for AI-powered writing)
OPENAI_API_KEY=your_openai_api_key_here

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_PERSON_ID

# X (Twitter) — OAuth 1.0a for write access
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# Threads (Meta)
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_USER_ID=your_threads_user_id_here

# Google Sheets / Docs (optional)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A1:C10
GOOGLE_DOC_ID=

# Email notifications (required for "content ready" emails)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENTS=you@example.com
EMAIL_USE_TLS=true

# Control
PUBLISH_MODE=pr-only
